{
  "mcpServers": {
    "dune": {
      "type": "http",
      "url": "https://api.dune.com/mcp/v1",
      "headers": {
        "x-dune-api-key": "${DUNE_API_KEY}"
      }
    },
    "helius": {
      "command": "npx",
      "args": ["-y", "helius-mcp"],
      "env": {
        "HELIUS_API_KEY": "${HELIUS_API_KEY}"
      }
    }
  }
}
